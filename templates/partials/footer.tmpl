{{define "footer"}}
<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="nav-logo" href="{{.HomeHref}}">
        <span class="nav-logo__tile" aria-hidden="true">
          <img src="/content/img/logo.png" alt="" width="128" height="128">
        </span>
        <span class="nav-logo__wordmark">EAGLE<span> AEROSPACE</span></span>
      </a>
      <p>{{tr .Strings "footer.about"}}</p>
    </div>

    <div class="footer__col">
      <div class="footer__title">{{tr .Strings "footer.nav_title"}}</div>
      <ul class="footer__nav">
        {{range .NavItems}}<li><a href="{{.Href}}">{{.Label}}</a></li>{{end}}
      </ul>
    </div>

    <div class="footer__col">
      <div class="footer__title">{{tr .Strings "footer.contact_title"}}</div>
      <ul class="footer__nav">
        <li><a href="mailto:{{.ContactInfo.Email}}">{{.ContactInfo.Email}}</a></li>
        <li><a href="tel:{{.ContactInfo.Phone}}">{{.ContactInfo.Phone}}</a></li>
        <li>{{range $i, $line := .ContactInfo.Address}}{{if $i}}<br>{{end}}{{$line}}{{end}}</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>{{tr .Strings "footer.copyright"}}</p>
  </div>
</footer>
{{end}}
