{{define "page"}}
{{with .Content}}
<section class="hero hero--bg">
  <div class="container hero__inner">
    <p class="eyebrow">{{.Tagline}}</p>
    <h1>{{.Heading}}</h1>
    <p class="hero__lead">{{.Lead}}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="{{$.HomeHref}}hangar">{{.CTACatalog}}</a>
      <a class="btn btn--ghost" href="{{$.HomeHref}}contact">{{.CTAContact}}</a>
    </div>

    {{with .Stats}}
    <dl class="hero__stats">
      {{range .}}
      <div class="hero__stat">
        <dt class="hero__stat-key">{{.Key}}</dt>
        <dd class="hero__stat-val">{{.Value}}</dd>
      </div>
      {{end}}
    </dl>
    {{end}}
  </div>
</section>

<section class="container section">
  <header class="section-head">
    <p class="eyebrow">{{.AreasEyebrow}}</p>
    <h2 class="section-head__title">{{.AreasHeading}}</h2>
    <p class="section-head__lead">{{.AreasLead}}</p>
  </header>

  <div class="feature-list">
    {{range .Highlights}}
    <article class="feature-row">
      {{if .ImgPath}}
      <figure class="feature-row__media media-frame">
        <img src="{{.ImgPath}}" alt="{{.Alt}}">
      </figure>
      {{end}}
      <div class="feature-row__body">
        <h3>{{.Title}}</h3>
        <p>{{.Text}}</p>
      </div>
    </article>
    {{end}}
  </div>
</section>
{{end}}
{{end}}
